<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="minutnik.MainWindow"
        Title="Minutnik Pomodoro"
        Width="800"
        Height="750"
        MinWidth="600"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F5">

    <Window.Styles>
    <Style Selector="Button">
        <Setter Property="Background" Value="#28624F"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#28624F"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="22,12"/>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3D8068"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="#3D8068"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#173D30"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="#173D30"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Foreground" Value="#173D30"/>
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    </Window.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="20">

            <TextBlock Text="Mój minutnik"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#28624F"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Czas na skupienie i zasłużony odpoczynek"
                       FontSize="15"
                       Foreground="#65736C"
                       HorizontalAlignment="Center"/>

            <Border Background="#FFFFFF"
                    CornerRadius="20"
                    Padding="25">

                <StackPanel Spacing="15">

                    <TextBlock x:Name="PhaseText"
                               Text="PRACA"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#28624F"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="TimeText"
                               Text="25:00"
                               FontSize="76"
                               FontWeight="Bold"
                               Foreground="#28624F"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="PhaseDetailText"
                               Text="Pełne skupienie"
                               FontSize="16"
                               Foreground="#65736C"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="12">

                        <Button x:Name="StartPauseButton"
                                Content="Uruchom"
                                Click="OnStartPauseClick"/>

                        <Button x:Name="ResetButton"
                                Content="Resetuj"
                                Click="OnResetClick"
                                Background="#E1EAE5"
                                Foreground="#173D30"
                                BorderBrush="#28624F"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Background="#FFFFFF"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel Spacing="15">

                    <TextBlock Text="Ustawienia czasu"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#28624F"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="20">

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Praca (minuty)"
                                       FontSize="14"
                                       Foreground="#65736C"/>

                            <NumericUpDown x:Name="WorkDurationInput"
                                           Value="25"
                                           Minimum="1"
                                           Maximum="120"
                                           Increment="1"
                                           FormatString="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Przerwa (minuty)"
                                       FontSize="14"
                                       Foreground="#65736C"/>

                            <NumericUpDown x:Name="BreakDurationInput"
                                           Value="5"
                                           Minimum="1"
                                           Maximum="120"
                                           Increment="1"
                                           FormatString="0"/>
                        </StackPanel>

                    </Grid>

                    <TextBlock Text="Po zmianie czasu naciśnij Resetuj, aby ustawić nowy czas na liczniku."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#65736C"/>

                </StackPanel>

            </Border>

            <Border Background="#FFFFFF"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel Spacing="10">

                    <TextBlock Text="Ukończone cykle"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#28624F"/>

                    <TextBlock x:Name="CycleText"
                               Text="0"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#28624F"/>

                    <TextBlock Text="HISTORIA CYKLI"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#65736C"
                               Margin="0,10,0,0"/>

                    <ListBox x:Name="HistoryList"
                             Height="120"
                             MinWidth="200"/>

                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>

</Window>